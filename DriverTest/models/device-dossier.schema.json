{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/driver-factory/device-dossier.schema.json",
  "title": "Device dossier intake schema",
  "description": "Evidence-oriented intake for a device model. It gathers requirements; it does not assert that a device, driver, simulator, or safety case exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dossierId", "status", "device", "interfaces", "behavior", "targets", "evidence", "safety"],
  "properties": {
    "schemaVersion": {"const": 1},
    "dossierId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,95}$"},
    "status": {"enum": ["intake", "awaiting_evidence", "review_ready", "accepted_for_modeling", "rejected"]},
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["manufacturer", "model", "hardwareRevision", "identifiers", "firmware", "protocolReferences"],
      "properties": {
        "manufacturer": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "hardwareRevision": {"type": "string", "minLength": 1},
        "identifiers": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "firmware": {"type": "string", "minLength": 1},
        "protocolReferences": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      }
    },
    "interfaces": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["transport", "functionalClass", "enumeration", "registersOrEndpoints", "interrupts", "dma"],
        "properties": {
          "transport": {"enum": ["usb", "bluetooth", "wifi", "pci_pcie", "i2c", "spi", "can_canfd", "ethernet", "storage", "gpio_pwm", "camera_mipi", "audio_i2s_tdm", "custom"]},
          "functionalClass": {"enum": ["char_control", "block_storage", "network_fieldbus", "continuous_stream", "actuator_motion_timing", "bus_controller_bridge"]},
          "enumeration": {"type": "string", "minLength": 1},
          "registersOrEndpoints": {"type": "string", "minLength": 1},
          "interrupts": {"type": "string", "minLength": 1},
          "dma": {"type": "string", "minLength": 1}
        }
      }
    },
    "behavior": {
      "type": "object", "additionalProperties": false,
      "required": ["transfer", "cacheCoherency", "concurrency", "lifecycle", "power", "timing", "errorRecovery"],
      "properties": {
        "transfer": {"type": "array", "items": {"enum": ["pio", "irq_fifo", "coherent_dma", "scatter_gather_dma"]}, "minItems": 1, "uniqueItems": true},
        "cacheCoherency": {"enum": ["hardware_coherent", "explicit_sync", "not_applicable", "unknown"]},
        "concurrency": {"type": "string", "minLength": 1},
        "lifecycle": {"type": "string", "minLength": 1},
        "power": {"type": "string", "minLength": 1},
        "timing": {"type": "string", "minLength": 1},
        "errorRecovery": {"type": "string", "minLength": 1}
      }
    },
    "targets": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceDocuments", "goldenTraces", "provenance", "missingItems"],
      "properties": {
        "sourceDocuments": {"type": "array", "items": {"type": "string"}},
        "goldenTraces": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "array", "items": {"type": "string"}},
        "missingItems": {"type": "array", "items": {"type": "string"}}
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "profileReference"],
      "properties": {
        "role": {"enum": ["non_safety", "monitor_only", "control", "monitoring_and_control", "undetermined"]},
        "profileReference": {"type": "string", "minLength": 1}
      }
    }
  }
}
